{
  "name": "@freerouter/sdk",
  "version": "0.1.0",
  "description": "BYOK multi-provider AI router — failover across free-tier LLMs",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/__fixtures__",
    "!src/tests"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.23",
    "@ai-sdk/groq": "^4.0.13",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@ai-sdk/provider": "^4.0.3",
    "ai": "^7.0.37"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  }
}
