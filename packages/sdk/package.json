{
  "name": "@freerouter/sdk",
  "version": "0.1.2",
  "description": "BYOK multi-provider AI router — failover across free-tier LLMs",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external @ai-sdk/google --external @ai-sdk/groq --external @ai-sdk/mistral --external @ai-sdk/openai-compatible --external @ai-sdk/provider --external ai",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun run test"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.23",
    "@ai-sdk/groq": "^4.0.13",
    "@ai-sdk/mistral": "4",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@ai-sdk/provider": "^4.0.3",
    "ai": "^7.0.37"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsup": "^8.5.1"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  }
}
