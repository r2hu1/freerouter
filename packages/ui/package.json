{
  "name": "@freerouter/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
