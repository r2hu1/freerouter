{
  "extends": "@freerouter/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node", "bun"],
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./web/src/*"]
    }
  },
  "include": ["src", "tests", "web/src"],
  "exclude": ["node_modules", "dist"]
}
